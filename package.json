{
  "name": "opencode-litellm-provider",
  "version": "0.4.3",
  "description": "OpenCode v2 plugin that auto-discovers providers, protocols, models and reasoning variants from a LiteLLM proxy",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpchen/opencode-litellm-provider.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare:core": "node scripts/prepare-core.mjs --from-provenance",
    "build:dist": "node scripts/build.mjs",
    "build:fixed": "node scripts/build.mjs --from-provenance",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typecheck": "node scripts/run-with-core.mjs typecheck",
    "test": "node scripts/run-with-core.mjs test",
    "test:delivery": "node --test scripts/check-core-delivery.mjs scripts/check-release-version.mjs",
    "test:distribution": "node scripts/test-distribution.mjs",
    "test:tui-render": "bun --conditions=browser scripts/test-tui-render.ts",
    "test:package": "bun scripts/test-package.ts",
    "test:e2e:opencode-v2": "node scripts/e2e-opencode-v2.mjs",
    "validate:spec": "openspec validate --all --strict --no-interactive",
    "test:openspec-closure": "node --test scripts/check-openspec-closure.test.mjs && node scripts/check-openspec-closure.mjs",
    "test:release-metadata": "node scripts/check-release-metadata.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.15 <2.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@opencode/plugin": "2.0.15",
    "@types/bun": "1.3.14",
    "@types/node": "24.4.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@opentui/solid": "^0.5.10",
    "jsonc-parser": "3.3.1",
    "solid-js": "^1.9.12"
  }
}
